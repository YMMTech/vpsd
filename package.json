{
  "name": "vpsd",
  "version": "0.1.0",
  "description": "VPSD — VPS Deployment: initialize one containerized application and prepare one VPS for CI-driven deployment.",
  "type": "module",
  "files": [
    "dist",
    "docs/installation.md",
    "docs/release-preparation.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "vpsd": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:integration": "VPSD_RUN_INTEGRATION_TESTS=1 vitest run --maxWorkers=1 tests/compose-caddy.integration.test.ts",
    "prevpsd": "pnpm build",
    "vpsd": "node dist/cli/index.js",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "license": "MIT",
  "keywords": [
    "vps",
    "deployment",
    "docker",
    "docker-compose",
    "caddy",
    "github-actions",
    "gitlab-ci",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Youness Mondir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YMMTech/vpsd.git"
  },
  "homepage": "https://github.com/YMMTech/vpsd#readme",
  "bugs": {
    "url": "https://github.com/YMMTech/vpsd/issues"
  }
}
