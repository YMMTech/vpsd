{
  "name": "simploy",
  "version": "0.1.0",
  "description": "CLI foundation for Simploy v0.",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "bin": {
    "simploy": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "presimploy": "pnpm build",
    "simploy": "node dist/cli/index.js",
    "test": "vitest run",
    "test:integration": "SIMPLOY_RUN_INTEGRATION_TESTS=1 vitest run --maxWorkers=1 tests/compose-caddy.integration.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
